  "flowDescriptions": {
    "blade": "物理范围伤害，适合沿用物理出战方案。",
    "ember": "火焰范围伤害，可针对雾铃与霜镜的火焰弱点。",
    "glacier": "冰霜范围伤害，可针对赤炉与龙眠的冰霜弱点。",
    "storm": "雷电范围伤害，可针对风栖的雷电弱点。",
    "arcanum": "奥术范围伤害，可针对沉星的奥术弱点。",
    "shade": "暗影范围伤害，可针对深潮的暗影弱点。",
    "venom": "毒素范围伤害；不额外附加持续中毒。",
    "ricochet": "物理范围伤害；与锋刃同伤害机制，不额外弹射。",
    "frostneedle": "冰霜范围伤害；与霜卫同伤害机制，不额外穿透。"
  }
