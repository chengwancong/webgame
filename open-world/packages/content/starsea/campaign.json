 "title": "裂星远航",
 "npcs": [
  {
   "id": "ss-npc-cheng",
   "name": "港务长·澄",
   "role": "拾星港港务长，主港管理、接取与归档；承认风险、不给空保证。",
   "voice": "短句、实事求是，先问船与人的状况。",
   "idle": [
    "船和人都还好？好。港里的事我盯着，岛上的事交给你。",
    "出港前看一眼补给。星潮不等人，也不会因为你累了就停。",
    "我不跟你保证下一座岛安全。我只保证你回来时，港还在。"
   ]
  },
  {
   "id": "ss-npc-milo",
   "name": "领航员·米洛",
   "role": "伙伴领航员，航图选择与旅程过渡；场景跟随不自动承诺战斗AI。",
   "voice": "活泼，有一点自嘲；行动时迅速收起玩笑。",
   "idle": [
    "航图我重新画过了——这次真没把海怪画成云。想去哪座岛？",
    "上回我迷路三次，三次都找回来了，这也算本事吧？要看航图吗？",
    "风向正好。要出发就趁现在，晚了星潮会把航线搅乱。"
   ]
  },
  {
   "id": "ss-npc-tongling",
   "name": "机巧师·铜铃",
   "role": "工坊与强化、武器盘说明；修复魔导设备。",
   "voice": "用具体零件解释问题，不用堆砌工程术语。",
   "idle": [
    "刀口卷了就拿来。换个卡榫的事，用不着整把重打。",
    "强化不靠运气：材料够不够、成功率多少，单子上都写着，看清再按。",
    "你那块武器盘的齿轮咬得有点紧，有空来工坊调一调。"
   ]
  },
  {
   "id": "ss-npc-qingmang",
   "name": "邮差·青芒",
   "role": "雾铃邮路信使，调查、采集制造引导。",
   "voice": "轻快但守信；对包裹内容保密，对危险诚实。",
   "idle": [
    "包裹里装的什么我不能说；路上哪儿有怪，我可以告诉你。",
    "顺路采点材料回来吧，我教你做点用得上的东西。",
    "我送信从不迟到——除非桥断了。桥断了也送得到，就是晚一点。"
   ]
  },
  {
   "id": "ss-npc-xuemi",
   "name": "记录官·雪弥",
   "role": "霜镜观测站与旧航约记录官，召唤石解读。",
   "voice": "精确，区分证据与猜测；偶尔很干的幽默。",
   "idle": [
    "观测记录显示星潮在变强。这是事实；“还会更糟”是推测，我分开记。",
    "召唤石上的刻纹我读懂了一半。另一半要么是古语，要么是刻的人手抖。",
    "要用召唤石就说一声。用法我讲清楚，后果也会。"
   ]
  },
  {
   "id": "ss-npc-mijia",
   "name": "暮界译者·弥迦",
   "role": "反征服派译者，解释暮界家书、难民证词与界桥计划。",
   "voice": "谨慎，先给可验证事实；不会替侵军免责。",
   "idle": [
    "家书我只照原文译，不替谁辩解。你想听，我就念给你。",
    "暮界不只有侵军。证词我都核对过，能证实的我才说。",
    "威能法典里记的力量，都是拿代价换来的。想学，先看清代价。"
   ]
  },
  {
   "id": "ss-npc-jinyu",
   "name": "龙裔见证者·烬羽",
   "role": "龙族航约见证者，龙眠岛与旧航网。",
   "voice": "庄重而朴素，用旧航行经历解释誓约。",
   "idle": [
    "旧航约第一句：先守住归途，再去远方。我守了很多年，还没守完。",
    "年轻时我也绕过这片暗礁。那时没有灯塔，只有星星。",
    "想证明自己，就来挑战。在誓约面前，强也好弱也好，都得说真话。"
   ]
  }
 ],
