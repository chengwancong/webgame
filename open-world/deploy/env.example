# 复制为 deploy/.env（.env 已被 .gitignore 忽略），按测试服填写。
AW_DOMAIN=staging.example.com
PG_PASSWORD=change-me
# 站点验证已停用，无需 AW_GATE_*。游戏账号登录独立保留。
# Web 客户端构建产物所在目录（本机 pnpm build 后上传，见 README）。
AW_WEB_DIST=./web-dist
# 正式模式：AW_MODE_NODE_ENV=production 且 AW_TEST_LOGIN=0
AW_MODE_NODE_ENV=development
AW_TEST_LOGIN=1
# Explicit staging opt-in only. No character state or rewards are accessed.
TACTICAL_SANDBOX=0
