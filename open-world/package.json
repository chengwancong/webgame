{
  "name": "abyss-walker-open-world",
  "private": true,
  "version": "0.4.2",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "node tools/dev.mjs",
    "setup:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/setup-windows.ps1",
    "service:install": "node tools/local-service.mjs install",
    "service:start": "node tools/local-service.mjs start",
    "service:stop": "node tools/local-service.mjs stop",
    "service:restart": "node tools/local-service.mjs restart",
    "service:status": "node tools/local-service.mjs status",
    "service:uninstall": "node tools/local-service.mjs uninstall",
    "web": "vite --config apps/web/vite.config.ts",
    "api": "tsx apps/api/src/main.ts",
    "assets": "python3 -X utf8 tools/build_assets.py",
    "art:open-world": "node tools/build-open-world-art.mjs",
    "art:open-world:verify": "node tools/verify-open-world-art.mjs",
    "art:five-islands": "node tools/build-five-island-art.mjs",
    "art:five-islands:verify": "node tools/verify-five-island-art.mjs",
    "build:ui": "python3 -X utf8 tools/build_ui_v2.py",
    "build:travel": "node tools/build-travel-assets.mjs",
    "check": "node tools/qa.mjs",
    "test:db": "vitest run tests/database.test.ts",
    "build": "node tools/world-graybox.mjs && node tools/build-ui-tokens.mjs && python3 -X utf8 tools/build_ui_v2.py && node tools/build-travel-assets.mjs && node tools/wardrobe-build.mjs && node tools/build-mini-hero.mjs && node tools/build-world-art.mjs && node tools/build-story-npcs.mjs && node tools/build-skill-fx.mjs && node tools/build-vfx-v2.mjs && node tools/build-apk-accepted-ui.mjs && node tools/build-telegraph-reuse.mjs && node tools/build-starsea-assets.mjs --props && node tools/build-open-world-art.mjs && node tools/build-plane-greybox-art.mjs && tsx tools/build-production-islands.ts && node tools/build-combat-layer-fx.mjs && node tools/build-combat-fx-metrics.mjs && vite build --config apps/web/vite.config.ts",
    "mini:verify": "node tools/verify-mini-hero.mjs",
    "desktop": "electron apps/desktop/main.cjs",
    "qa": "node tools/qa.mjs",
    "test:core": "vitest run tests/simulation.test.ts",
    "content": "node tools/world-graybox.mjs && tsx tools/build-production-islands.ts && tsx tools/validate-content.ts",
    "config:export": "node tools/config-export.mjs",
    "config:check": "node tools/config-export.mjs --check",
    "balance": "tsx tools/balance.ts",
    "spine:targets": "tsx tools/spine/targets-cli.ts",
    "spine:bench": "tsx tools/spine/cli.ts bench",
    "spine:audit": "tsx tools/spine/cli.ts audit",
    "spine:normalize": "tsx tools/spine/cli.ts normalize",
    "spine:solve-builds": "tsx tools/spine/cli.ts solve-builds",
    "spine:monsters": "tsx tools/spine/cli.ts monsters",
    "spine:progression": "tsx tools/spine/cli.ts progression",
    "spine:validate": "tsx tools/spine/cli.ts validate",
    "spine:check": "tsx tools/spine/cli.ts check",
    "pacing:marginals": "tsx tools/pacing/marginals.ts",
    "pacing:derive": "tsx tools/pacing/derive.ts",
    "pacing:validate": "tsx tools/pacing/validate.ts",
    "ui:tokens": "node tools/build-ui-tokens.mjs",
    "ui:tokens:check": "node tools/build-ui-tokens.mjs --check",
    "ui:verify": "node tools/verify-ui-foundation.mjs",
    "starsea:assets": "node tools/build-starsea-assets.mjs --props",
    "starsea:validate": "node tools/validate-starsea-assets.mjs",
    "starsea:verify": "node tools/verify-starsea-art.mjs",
    "world:graybox": "node tools/world-graybox.mjs",
    "world:aoi": "tsx tools/world-aoi-bench.ts",
    "world:horde": "node tools/horde-bench.mjs",
    "world:generate": "tsx tools/build-production-islands.ts"
    ,"world:resources:check": "tsx tools/check-world-resource-wiring.ts"
  },
  "dependencies": {
    "@esotericsoftware/spine-webgl": "4.2.120",
    "@fastify/cookie": "11.0.2",
    "@fastify/static": "8.3.0",
    "@fastify/websocket": "11.3.1",
    "fastify": "5.12.5",
    "pg": "8.16.3",
    "phaser": "4.2.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/ws": "^8.18.2",
    "electron": "40.0.0",
    "playwright": "1.58.2",
    "sharp": "0.34.5",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.18",
    "ws": "^8.22.0"
  }
}
