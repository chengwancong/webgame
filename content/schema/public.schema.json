{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "abyss-walker public content",
  "type": "object",
  "required": ["skills", "encounters"],
  "additionalProperties": false,
  "properties": {
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "cooldown_ticks", "range", "damage", "resource_cost", "windup_ticks"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "name": {"type": "string", "minLength": 1},
          "kind": {"enum": ["single", "area"]},
          "cooldown_ticks": {"type": "integer", "minimum": 1},
          "range": {"type": "number", "exclusiveMinimum": 0},
          "damage": {"type": "integer", "minimum": 0},
          "resource_cost": {"type": "integer", "minimum": 0},
          "windup_ticks": {"type": "integer", "minimum": 0}
        }
      }
    },
    "encounters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "arena", "actors"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "name": {"type": "string", "minLength": 1},
          "seed": {"type": "integer", "minimum": 1},
          "arena": {
            "type": "object",
            "required": ["width", "height"],
            "additionalProperties": false,
            "properties": {
              "width": {"type": "number", "exclusiveMinimum": 0},
              "height": {"type": "number", "exclusiveMinimum": 0}
            }
          },
          "actors": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["id", "side", "max_hp", "damage", "range", "attack_ticks", "speed", "x"],
              "additionalProperties": false,
              "properties": {
                "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                "side": {"enum": ["player", "enemy"]},
                "max_hp": {"type": "integer", "minimum": 1},
                "damage": {"type": "integer", "minimum": 0},
                "range": {"type": "number", "exclusiveMinimum": 0},
                "attack_ticks": {"type": "integer", "minimum": 1},
                "speed": {"type": "number", "minimum": 0},
                "x": {"type": "number"}
              }
            }
          }
        }
      }
    }
  }
}
